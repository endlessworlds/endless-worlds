# Copy to .env and fill in. Only the AI server (python_server) uses the API keys;
# the game itself reads just RELAY_URL and API_URL.

# AI server (host only) - free key at https://console.groq.com
GROQ_API_KEY=

# Multiplayer relay (Cloudflare Worker, see relay/README.md)
RELAY_URL=wss://endless-worlds-relay.srujanmpadmashali.workers.dev

# Optional: a hosted AI server everyone can use instead of http://127.0.0.1:8000
# API_URL=https://your-space.hf.space
